# PULP 4.0 • copiá como .env; nunca lo publiques ni lo subas a Git.
# Abrir.command y Configurar.command NO solicitan seeds ni private keys.
# Dejá los valores vacíos para iniciar local sin proveedores propios.
PULP_JUPITER_KEY=
PULP_RPC_URL=
PULP_HISTORY_PROVIDER=rpc
PULP_HISTORY_LIMIT=5000
# rpc = historial parcial. helius = requiere endpoint Helius con el método habilitado.
# Descubrimiento en segundo plano consume cuota. Opt-in explícito.
PULP_DISCOVERY_ENABLED=0
# Bloqueo por defecto de preparadores nuevos: CPMM, LaunchLab, vesting y Squads.
# Habilitar no significa auditar. Revisar primero protocolo, cuentas y entorno.
PULP_ENABLE_PROTOCOL_WRITES=0
PULP_PAUSE_FINANCIAL=0
PULP_MERCHANT_WALLET=
PULP_SQUADS_MULTISIG=
PULP_PINATA_JWT=
# Opcionales: solo configuraciones oficiales comprobadas de Raydium.
PULP_LAUNCHLAB_CONFIG=
PULP_LAUNCHLAB_PLATFORM=
# Modo público: todos estos valores obligatorios, además de proxy HTTPS.
# No completar para uso local. No exponer el puerto de Node a internet.
PULP_PUBLIC_ORIGIN=
PULP_ADMIN_WALLET=
PULP_SUPABASE_URL=
PULP_SUPABASE_SERVICE_KEY=
PULP_ENCRYPTION_KEY=
PULP_TRUST_PROXY=0
# No fijar PORT para conservar la selección automática en Mac.
# PORT=4173
# PULP_DATA_DIR=/ruta/privada
